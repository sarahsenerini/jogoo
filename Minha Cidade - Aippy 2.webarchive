  var _suspendTimerId = null;
  var lastFrameTime = 0;
  var windowFrameTimes = [];
  var windowLongtaskCount = 0;
  var windowLongtaskTotalMs = 0;
  var windowFreezeCount = 0;
  var sampleStartTime = 0;
  var sampleIndex = 0;
  var windowRoundCount = 0;
  var windowStartTime = 0;
  var windowHiddenAccumMs = 0;
  var webglContextLost = false;
  var isPageVisible = true;
  var hiddenSince = 0;
  var hiddenAccumMs = 0;
  var stopped = false;
  var longtaskObserver = null;
  var interactionDetected = false;
  var phase = 'idle';
  var _blackConsecutiveCount = 0;
  var _bsTimerId = null;
  var _bsLatestRatio = null;
  var _bsAlerted = false;
  var _bsWindow = { samples: 0, hits: 0, sum: 0, max: null };

  // ‚îÄ‚îÄ‚îÄ Black screen detection offscreen canvas ‚îÄ‚îÄ‚îÄ
  var _sampleCanvas = null;
  var _sampleCtx = null;
  var BS_ALPHA_THRESHOLD = 10;
  var BS_LUMA_THRESHOLD = 15;
  var BS_MIN_VISIBLE_PIXELS = 100;

  // ‚îÄ‚îÄ‚îÄ Long Task Observer ‚îÄ‚îÄ‚îÄ

  if (typeof PerformanceObserver !== 'undefined') {
    try {
      longtaskObserver = new PerformanceObserver(function(list) {
        if (phase !== 'active') return;
        list.getEntries().forEach(function(entry) {
          windowLongtaskCount++;
          windowLongtaskTotalMs += entry.duration;
        });
      });
      longtaskObserver.observe({ type: 'longtask', buffered: true });
    } catch (e) {}
  }

  // ‚îÄ‚îÄ‚îÄ Canvas tracking (MutationObserver) ‚îÄ‚îÄ‚îÄ

  var _canvasRefs = [];
  var _canvasObserver = null;

  function trackCanvas(c) {
    if (c.__aippyPerfWatched) return;
    c.__aippyPerfWatched = true;
    _canvasRefs.push(c);
    c.addEventListener('webglcontextlost', function() {
      webglContextLost = true;
    });
  }

  function untrackCanvas(c) {
    var idx = _canvasRefs.indexOf(c);
    if (idx !== -1) _canvasRefs.splice(idx, 1);
  }

  function initCanvasObserver() {
    try {
      document.querySelectorAll('canvas').forEach(trackCanvas);
    } catch (e) {}
    if (typeof MutationObserver === 'undefined') return;
    try {
      _canvasObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(m) {
          m.addedNodes.forEach(function(n) {
            if (n.nodeName === 'CANVAS') trackCanvas(n);
            if (n.querySelectorAll) {
              try { n.querySelectorAll('canvas').forEach(trackCanvas); } catch (e) {}
            }
          });
          m.removedNodes.forEach(function(n) {
            if (n.nodeName === 'CANVAS') untrackCanvas(n);
            if (n.querySelectorAll) {
              try { n.querySelectorAll('canvas').forEach(untrackCanvas); } catch (e) {}
            }
          });
        });
      });
      _canvasObserver.observe(document.documentElement, { childList: true, subtree: true });
    } catch (e) {}
  }

  function getCanvasMaxPixels() {
    var maxPixels = 0;
    for (var i = 0; i < _canvasRefs.length; i++) {
      var c = _canvasRefs[i];
      var px = (c.width || 0) * (c.height || 0);
      if (px > maxPixels) maxPixels = px;
    }
    return maxPixels;
  }

  // ‚îÄ‚îÄ‚îÄ Canvas black screen detection ‚îÄ‚îÄ‚îÄ
  // Uses drawImage to scale the full canvas down to a 64√ó64 offscreen sample,
  // then applies Rec.709 perceptual luma analysis with alpha filtering.
  // WebGL canvases with preserveDrawingBuffer=false are skipped (buffer is
  // cleared after compositing ‚Äî readPixels/drawImage would always read zeros).

  function getSampleCtx() {
    var size = perfConfig.blackScreenSampleSize;
    if (!_sampleCtx || _sampleCanvas.width !== size) {
      _sampleCanvas = document.createElement('canvas');
      _sampleCanvas.width = size;
      _sampleCanvas.height = size;
      _sampleCtx = _sampleCanvas.getContext('2d', { willReadFrequently: true });
    }
    return _sampleCtx;
  }

  // Probe the canvas for an existing WebGL context to check preserveDrawingBuffer.
  // Uses the live prototype (always the current native or hybrid) instead of the
  // saved _nativeGetContext reference, which can become stale in Electron webviews
  // where preload scripts temporarily patch the prototype before page scripts run.
  // The webgl fallback suppresses webglcontextcreationerror to prevent noise in
  // apps that register persistent error listeners (e.g. Three.js WebGLRenderer).
  function probeWebGLContext(canvas) {
    var getCtx = HTMLCanvasElement.prototype.getContext;
    var gl = getCtx.call(canvas, 'webgl2');
    if (gl) return gl;
    var suppress = function(e) { e.stopImmediatePropagation(); };
    canvas.addEventListener('webglcontextcreationerror', suppress, true);
    try {
      gl = getCtx.call(canvas, 'webgl');
    } finally {
      canvas.removeEventListener('webglcontextcreationerror', suppress, true);
    }
    return gl;
  }

  function detectCanvasBlackScreen() {
    if (!perfConfig.blackScreenEnabled) return null;
    try {
      if (!_canvasRefs.length) return null;

      var target = null;
      var maxPx = 0;
      for (var i = 0; i < _canvasRefs.length; i++) {
        var c = _canvasRefs[i];
        var px = (c.width || 0) * (c.height || 0);
        if (px > maxPx) { maxPx = px; target = c; }
      }
      if (!target || target.width < 2 || target.height < 2) return null;

      // WebGL with preserveDrawingBuffer=false: buffer is cleared after
      // compositing so any read (readPixels or drawImage) returns all zeros.
      var gl = probeWebGLContext(target);
      if (gl) {
        try {
          var attrs = gl.getContextAttributes();
          if (!attrs || !attrs.preserveDrawingBuffer) return null;
        } catch (e) { return null; }
      }

      var ctx = getSampleCtx();
      if (!ctx) return null;
      var size = perfConfig.blackScreenSampleSize;
      ctx.clearRect(0, 0, size, size);
      ctx.drawImage(target, 0, 0, size, size);
      var imageData = ctx.getImageData(0, 0, size, size);
      return analyzeLuma(imageData.data);
    } catch (e) {
      return null;
    }
  }

  function analyzeLuma(data) {
    var visible = 0;
    var nearBlack = 0;
    for (var i = 0; i < data.length; i += 4) {
      if (data[i + 3] < BS_ALPHA_THRESHOLD) continue;
      visible++;
      var L = 0.2126 * data[i] + 0.7152 * data[i + 1] + 0.0722 * data[i + 2];
      if (L < BS_LUMA_THRESHOLD) nearBlack++;
    }
    if (visible < BS_MIN_VISIBLE_PIXELS) return null;
    return Math.round(nearBlack / visible * 10000) / 100;
  }

  // ‚îÄ‚îÄ‚îÄ Black screen window aggregation (aligned with 15s perf window) ‚îÄ‚îÄ‚îÄ

  function resetBsWindow() {
    _bsWindow.samples = 0;
    _bsWindow.hits = 0;
    _bsWindow.sum = 0;
    _bsWindow.max = null;
  }

  function recordBlackScreenSample(ratio) {
    if (ratio === null) return;
    _bsWindow.samples++;
    _bsWindow.sum += ratio;
    if (_bsWindow.max === null || ratio > _bsWindow.max) _bsWindow.max = ratio;
    if (ratio >= perfConfig.blackScreenThreshold * 100) _bsWindow.hits++;
  }

  function takeBlackScreenWindowStats() {
    var stats = {
      black_screen_sample_count: _bsWindow.samples,
      black_screen_hit_count: _bsWindow.hits,
      canvas_black_ratio_max: _bsWindow.samples > 0 ? _bsWindow.max : null,
      canvas_black_ratio_avg: _bsWindow.samples > 0
        ? Math.round(_bsWindow.sum / _bsWindow.samples * 100) / 100
        : null,
      canvas_black_ratio: _bsLatestRatio,
    };
    resetBsWindow();
    return stats;
  }

  function attachBlackScreenStats(report) {
    var stats = takeBlackScreenWindowStats();
    report.black_screen_sample_count = stats.black_screen_sample_count;
    report.black_screen_hit_count = stats.black_screen_hit_count;
    report.canvas_black_ratio_max = stats.canvas_black_ratio_max;
    report.canvas_black_ratio_avg = stats.canvas_black_ratio_avg;
    report.canvas_black_ratio = stats.canvas_black_ratio;
  }

  // ‚îÄ‚îÄ‚îÄ Black screen alert & probe ‚îÄ‚îÄ‚îÄ

  function reportBlackScreenAlert(ratio) {
    if (!_reportingEnabled) return;
    try {
      var RumSDK = window.RumSDK && window.RumSDK.default;
      if (RumSDK && typeof RumSDK.sendCustom === 'function') {
        RumSDK.sendCustom({
          type: 'error',
          name: 'canvas_black_screen',
          group: 'perf-monitor',
          value: ratio,
          properties: {
            project_uuid: _projectUuid || 'unknown',
            url: window.location.href || '',
            uid: _userUid || 'unknown',
            version: _projectVersion,
            black_ratio_pct: ratio,
            canvas_max_pixels: getCanvasMaxPixels(),
          },
        });
      }
    } catch (e) {}
    notifyParent('canvas-black-screen', { ratio: ratio });
    notifyIOS('perf.blackScreen', { ratio: ratio });
  }

  function startBlackScreenProbe() {
    if (_bsTimerId || !perfConfig.blackScreenEnabled) return;
    _blackConsecutiveCount = 0;
    _bsTimerId = setInterval(function() {
      if (!isPageVisible || stopped) return;
      var ratio = detectCanvasBlackScreen();
      _bsLatestRatio = ratio;
      recordBlackScreenSample(ratio);
      if (ratio !== null && ratio >= perfConfig.blackScreenThreshold * 100) {
        _blackConsecutiveCount++;
      } else {
        _blackConsecutiveCount = 0;
        _bsAlerted = false;
      }
      if (_blackConsecutiveCount >= perfConfig.blackScreenConsecutiveRequired && !_bsAlerted) {
        _bsAlerted = true;
        reportBlackScreenAlert(ratio);
      }
    }, perfConfig.blackScreenSampleIntervalMs);
  }

  function stopBlackScreenProbe() {
    if (_bsTimerId) { clearInterval(_bsTimerId); _bsTimerId = null; }
    _blackConsecutiveCount = 0;
    _bsAlerted = false;
    _bsLatestRatio = null;
  }

  // ‚îÄ‚îÄ‚îÄ Performance score ‚îÄ‚îÄ‚îÄ
  // Weighted deduction model: starts at 100, deducts per dimension.

  function clamp(v, min, max) {
    return v < min ? min : (v > max ? max : v);
  }

  function computePerfScore(report) {
    if (!report || report.frame_count < 10) return null;

    var score = 100;

    // FPS baseline (30 pts) ‚Äî below 50 starts deducting, below 20 full deduction
    score -= 30 - clamp((report.fps - 20) / (50 - 20), 0, 1) * 30;

    // FPS stability (20 pts) ‚Äî std < 3 full marks, > 15 full deduction
    if (report.fps_std > 0) {
      score -= 20 - clamp((15 - report.fps_std) / (15 - 3), 0, 1) * 20;
    }

    // Jank ratio (15 pts) ‚Äî < 5% full marks, > 30% full deduction
    var jankRatio = report.jank_count / Math.max(report.frame_count, 1);
    score -= 15 - clamp((0.30 - jankRatio) / (0.30 - 0.05), 0, 1) * 15;

    // Freeze events (15 pts) ‚Äî 0 full marks, 5 pts per freeze, max 15
    score -= Math.min(report.freeze_count * 5, 15);

    // Main thread blocking (10 pts) ‚Äî < 5% full marks, > 25% full deduction
    var blockRatio = report.longtask_total_ms / (sampleIntervalS * 1000);
    score -= 10 - clamp((0.25 - blockRatio) / (0.25 - 0.05), 0, 1) * 10;

    // Memory pressure (5 pts) ‚Äî < 100MB full marks, > 500MB full deduction
    if (report.memory) {
      score -= 5 - clamp((500 - report.memory.used_mb) / (500 - 100), 0, 1) * 5;
    }

    // WebGL context lost (5 pts) ‚Äî instant full deduction
    if (report.webgl_context_lost) {
      score -= 5;
    }

    return Math.max(0, Math.round(score));
  }

  function getPerfGrade(score) {
    if (score === null) return null;
    if (score >= 90) return 'A';
    if (score >= 70) return 'B';
    if (score >= 50) return 'C';
    return 'D';
  }

  // ‚îÄ‚îÄ‚îÄ Report computation ‚îÄ‚îÄ‚îÄ

  function computeWindowReport() {
    var frames = windowFrameTimes;
    var totalFrames = frames.length;
    if (totalFrames < 10) return null;

    var sum = 0;
    var jankCount = 0;
    var fN = 0, fMean = 0, fM2 = 0;
    for (var i = 0; i < totalFrames; i++) {
      sum += frames[i];
      if (frames[i] > perfConfig.jankThresholdMs) jankCount++;
      var instantFps = 1000 / frames[i];
      fN++;
      var d = instantFps - fMean;
      fMean += d / fN;
      fM2 += d * (instantFps - fMean);
    }
    var freezeCount = windowFreezeCount;

    var avgFrameTime = sum / totalFrames;
    var fps = avgFrameTime > 0 ? 1000 / avgFrameTime : 0;
    var fpsStd = fN > 1 ? Math.sqrt(fM2 / (fN - 1)) : 0;

    var rawWall = performance.now() - sampleStartTime;
    var currentHidden = (isPageVisible || hiddenSince <= 0) ? 0 : (performance.now() - hiddenSince);
    var wallTime = (rawWall - hiddenAccumMs - currentHidden) / 1000;
    if (wallTime < 1) wallTime = sampleIntervalS;
    var throughput = Math.round(totalFrames / wallTime * 10) / 10;

    var mem = null;
    try {
      if (performance.memory) {
        mem = {
          used_mb: Math.round(performance.memory.usedJSHeapSize / 1048576),
          total_mb: Math.round(performance.memory.totalJSHeapSize / 1048576),
          limit_mb: Math.round(performance.memory.jsHeapSizeLimit / 1048576)
        };
      }
    } catch (e) {}

    var canvasMaxPixels = getCanvasMaxPixels();
    var pageUrl = '';
    try { pageUrl = window.location.href; } catch (e) {}

    var report = {
      url: pageUrl,
      fps: Math.round(fps * 10) / 10,
      fps_std: Math.round(fpsStd * 100) / 100,
      frame_time: Math.round(avgFrameTime * 100) / 100,
      throughput: throughput,
      jank_count: jankCount,
      freeze_count: freezeCount,
      frame_count: totalFrames,
      longtask_count: windowLongtaskCount,
      longtask_total_ms: Math.round(windowLongtaskTotalMs),
      memory: mem,
      canvas_max_pixels: canvasMaxPixels,
      canvas_black_ratio: null,
      webgl_context_lost: webglContextLost,
      sample_index: sampleIndex,
      sampled_at: new Date().toISOString(),
    };

    report.perf_score = computePerfScore(report);
    report.perf_grade = getPerfGrade(report.perf_score);

    return report;
  }

  function resetWindow() {
    windowFrameTimes = [];
    windowLongtaskCount = 0;
    windowLongtaskTotalMs = 0;
    windowFreezeCount = 0;
  }

  // ‚îÄ‚îÄ‚îÄ Remote config gate ‚îÄ‚îÄ‚îÄ

  function tryEnableReporting() {
    var sdk = window.RumSDK && window.RumSDK.default;
    if (!sdk || typeof sdk.getConfig !== 'function') return false;
    try {
      var cfg = sdk.getConfig();
      var rate = cfg && cfg.sessionConfig && cfg.sessionConfig.sampleRate;
      if (typeof rate === 'number' && rate > 0) {
        _reportingEnabled = true;
        if (_rumEnv === 'test') console.log('[aippy-perf] Remote config ready, sampleRate:', rate);
        return true;
      }
    } catch (e) {}
    return false;
  }

  function waitForRemoteConfig() {
    if (tryEnableReporting()) return;
    var attempts = 0;
    var maxAttempts = 60;
    var poll = setInterval(function() {
      attempts++;
      if (tryEnableReporting() || attempts >= maxAttempts) {
        clearInterval(poll);
        if (!_reportingEnabled && _rumEnv === 'test') {
          console.warn('[aippy-perf] Remote config not received, reporting stays disabled');
        }
      }
    }, 500);
  }

  // ‚îÄ‚îÄ‚îÄ Report dispatch ‚îÄ‚îÄ‚îÄ

  function finalizeAndSendReport(report) {
    if (!report) return;
    attachBlackScreenStats(report);
    sendReport(report);
  }

  function sendReport(report) {
    if (!report || !_reportingEnabled) return;

    if (_rumEnv === 'test') console.log('[aippy-perf]', report);
    notifyParent('perf-report', { payload: report });
    notifyIOS('perf.report', report);

    // Report to ARMS RUM via sendCustom
    try {
      var RumSDK = window.RumSDK && window.RumSDK.default;
      if (RumSDK && typeof RumSDK.sendCustom === 'function') {
        RumSDK.sendCustom({
          type: 'perf',
          name: 'game_runtime_perf',
          group: 'perf-monitor',
          value: report.fps,
          properties: {
            url: report.url || '',
            project_uuid: _projectUuid || 'unknown',
            version: _projectVersion,
            uid: _userUid || 'unknown',
            fps: report.fps,
            fps_std: report.fps_std,
            frame_time: report.frame_time,
            throughput: report.throughput,
            jank_count: report.jank_count,
            freeze_count: report.freeze_count,
            frame_count: report.frame_count,
            longtask_count: report.longtask_count,
            longtask_total_ms: report.longtask_total_ms,
            memory_used_mb: report.memory ? report.memory.used_mb : -1,
            memory_total_mb: report.memory ? report.memory.total_mb : -1,
            canvas_max_pixels: report.canvas_max_pixels,
            black_screen_sample_count: report.black_screen_sample_count || 0,
            black_screen_hit_count: report.black_screen_hit_count || 0,
            canvas_black_ratio: report.canvas_black_ratio !== null ? report.canvas_black_ratio : -1,
            canvas_black_ratio_max: report.canvas_black_ratio_max !== null ? report.canvas_black_ratio_max : -1,
            canvas_black_ratio_avg: report.canvas_black_ratio_avg !== null ? report.canvas_black_ratio_avg : -1,
            webgl_context_lost: report.webgl_context_lost ? 1 : 0,
            perf_score: report.perf_score !== null ? report.perf_score : -1,
            perf_grade: report.perf_grade || 'N/A',
            sample_index: report.sample_index,
          },
        });
      }
    } catch (e) {}
  }

  // ‚îÄ‚îÄ‚îÄ Visibility ‚îÄ‚îÄ‚îÄ

  function onVisibilityChange() {
    if (document.hidden) {
      isPageVisible = false;
      hiddenSince = performance.now();
      stopBlackScreenProbe();
    } else {
      isPageVisible = true;
      if (hiddenSince > 0) {
        var hiddenDuration = performance.now() - hiddenSince;
        hiddenAccumMs += hiddenDuration;
        windowHiddenAccumMs += hiddenDuration;
        hiddenSince = 0;
      }
      lastFrameTime = performance.now();
      if (phase === 'active' && !_suspendTimerId) startBlackScreenProbe();
    }
  }
  document.addEventListener('visibilitychange', onVisibilityChange);

  window.addEventListener('pagehide', function() {
    if (stopped || phase !== 'active') return;
    var lastReport = computeWindowReport();
    if (lastReport) finalizeAndSendReport(lastReport);
  });

  // ‚îÄ‚îÄ‚îÄ Interaction detection ‚îÄ‚îÄ‚îÄ

  function onFirstInteraction() {
    if (interactionDetected || stopped) return;
    interactionDetected = true;
    if (_idleTimerId) { clearTimeout(_idleTimerId); _idleTimerId = null; }
    activateFromIdle();
  }

  var interactionEvents = ['pointerdown', 'touchstart', 'mousedown', 'keydown'];
  function addInteractionListeners() {
    interactionEvents.forEach(function(evt) {
      document.addEventListener(evt, onFirstInteraction, { once: true, capture: true, passive: true });
    });
  }
  function removeInteractionListeners() {
    interactionEvents.forEach(function(evt) {
      document.removeEventListener(evt, onFirstInteraction, { capture: true });
    });
  }

  // ‚îÄ‚îÄ‚îÄ Frame loop ‚îÄ‚îÄ‚îÄ

  var _idleTimerId = null;

  function activateFromIdle() {
    if (stopped || phase !== 'idle') return;
    phase = 'active';
    var now = performance.now();
    lastFrameTime = 0;
    sampleStartTime = now;
    hiddenAccumMs = 0;
    windowStartTime = now;
    windowRoundCount = 0;
    windowHiddenAccumMs = 0;
    sampleIndex = 0;
    resetWindow();
    resetBsWindow();
    initCanvasObserver();
    removeInteractionListeners();
    startBlackScreenProbe();
    rafId = requestAnimationFrame(onFrame);
  }

  function onFrame(now) {
    if (stopped) return;
    rafId = requestAnimationFrame(onFrame);

    if (!isPageVisible) return;
    if (phase !== 'active') return;

    if (lastFrameTime > 0) {
      var dt = now - lastFrameTime;
      if (dt > 0 && dt < 500) {
        windowFrameTimes.push(dt);
      } else if (dt >= 500) {
        windowFreezeCount++;
      }
    }
    lastFrameTime = now;

    var elapsed = (now - sampleStartTime - hiddenAccumMs) / 1000;
    if (elapsed >= sampleIntervalS) {
      if (windowRoundCount < perfConfig.maxRoundsPerWindow) {
        var report = computeWindowReport();
        finalizeAndSendReport(report);
        sampleIndex++;
        windowRoundCount++;
      }
      sampleStartTime = now;
      hiddenAccumMs = 0;
      resetWindow();

      if (windowRoundCount >= perfConfig.maxRoundsPerWindow) {
        suspendUntilNextWindow(now);
        return;
      }
    }
  }

  function suspendUntilNextWindow(now) {
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
    stopBlackScreenProbe();
    var windowElapsed = now - windowStartTime - windowHiddenAccumMs;
    var remaining = sampleWindowS * 1000 - windowElapsed;
    if (remaining < 1000) remaining = 1000;
    _suspendTimerId = setTimeout(function() {
      _suspendTimerId = null;
      if (stopped) return;
      windowStartTime = performance.now();
      windowRoundCount = 0;
      windowHiddenAccumMs = 0;
      sampleStartTime = performance.now();
      hiddenAccumMs = 0;
      lastFrameTime = 0;
      resetWindow();
      startBlackScreenProbe();
      rafId = requestAnimationFrame(onFrame);
    }, remaining);
  }

  // ‚îÄ‚îÄ‚îÄ Lifecycle ‚îÄ‚îÄ‚îÄ

  function start() {
    if (stopped) return;
    phase = 'idle';
    lastFrameTime = 0;
    addInteractionListeners();
    _idleTimerId = setTimeout(activateFromIdle, perfConfig.idleFallbackS * 1000);
  }

  function stop() {
    stopped = true;
    phase = 'done';
    stopBlackScreenProbe();
    var lastReport = computeWindowReport();
    if (lastReport) finalizeAndSendReport(lastReport);
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
    if (_idleTimerId) { clearTimeout(_idleTimerId); _idleTimerId = null; }
    if (_suspendTimerId) { clearTimeout(_suspendTimerId); _suspendTimerId = null; }
    if (longtaskObserver) {
      try { longtaskObserver.disconnect(); } catch (e) {}
    }
    if (_canvasObserver) {
      try { _canvasObserver.disconnect(); } catch (e) {}
    }
    removeInteractionListeners();
    document.removeEventListener('visibilitychange', onVisibilityChange);
  }

  function updateConfig(cfg) {
    if (!cfg || typeof cfg !== 'object') return;
    if (typeof cfg.interval === 'number' && cfg.interval > 0) {
      sampleIntervalS = cfg.interval;
    }
    if (typeof cfg.idleFallbackS === 'number') {
      perfConfig.idleFallbackS = Math.max(1, Math.round(cfg.idleFallbackS));
      if (phase === 'idle' && _idleTimerId) {
        clearTimeout(_idleTimerId);
        _idleTimerId = setTimeout(activateFromIdle, perfConfig.idleFallbackS * 1000);
      }
    }
    if (typeof cfg.jankThresholdMs === 'number') {
      perfConfig.jankThresholdMs = Math.max(8, Math.round(cfg.jankThresholdMs));
    }
    if (typeof cfg.maxRoundsPerWindow === 'number') {
      perfConfig.maxRoundsPerWindow = Math.max(1, Math.round(cfg.maxRoundsPerWindow));
    }
    if (typeof cfg.blackScreenEnabled === 'boolean') {
      var wasEnabled = perfConfig.blackScreenEnabled;
      perfConfig.blackScreenEnabled = cfg.blackScreenEnabled;
      if (!wasEnabled && cfg.blackScreenEnabled && phase === 'active') {
        startBlackScreenProbe();
      } else if (wasEnabled && !cfg.blackScreenEnabled) {
        stopBlackScreenProbe();
      }
    }
    if (typeof cfg.blackScreenThreshold === 'number') {
      perfConfig.blackScreenThreshold = clamp(cfg.blackScreenThreshold, 0, 1);
    }
    if (typeof cfg.blackScreenConsecutiveRequired === 'number') {
      perfConfig.blackScreenConsecutiveRequired = Math.max(1, Math.round(cfg.blackScreenConsecutiveRequired));
    }
    if (typeof cfg.blackScreenSampleIntervalMs === 'number') {
      perfConfig.blackScreenSampleIntervalMs = Math.max(200, Math.round(cfg.blackScreenSampleIntervalMs));
      if (_bsTimerId) { stopBlackScreenProbe(); startBlackScreenProbe(); }
    }
    if (typeof cfg.blackScreenSampleSize === 'number') {
      perfConfig.blackScreenSampleSize = clamp(Math.round(cfg.blackScreenSampleSize), 16, 256);
    }
  }

  // ‚îÄ‚îÄ‚îÄ GrowthBook remote config ‚îÄ‚îÄ‚îÄ

  var _gbInstance = null;

  function loadGrowthBook() {
    try {
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/@growthbook/growthbook/dist/bundles/index.min.js';
      s.onload = initGrowthBook;
      s.onerror = function() {
        if (_rumEnv === 'test') console.warn('[aippy-perf] GrowthBook SDK load failed');
      };
      document.head.appendChild(s);
    } catch (e) {}
  }

  function initGrowthBook() {
    var GB = window.growthbook && window.growthbook.GrowthBook;
    if (!GB) return;

    var isDev = window.__rum && window.__rum.env === 'test';
    var gb = new GB({
      apiHost: isDev ? 'https://growthbook-api.aippy.dev' : 'https://growthbook-api.aippy.ai',
      clientKey: isDev ? 'sdk-VHdlw9oDt3bW5dIh' : 'sdk-XMxSsd3pSdwf5ZF',
      attributes: {
        id: _userUid || _projectUuid || 'anonymous',
        user_id: _userUid || _projectUuid || 'anonymous',
        project_uuid: _projectUuid,
        version: _projectVersion,
        env: isDev ? 'test' : 'prod',
      },
      trackingCallback: function(experiment, result) {
        try {
          var RumSDK = window.RumSDK && window.RumSDK.default;
          if (RumSDK && typeof RumSDK.sendCustom === 'function') {
            RumSDK.sendCustom({
              type: 'experiment',
              name: experiment.key,
              group: 'growthbook',
              value: result.variationId,
              properties: {
                project_uuid: _projectUuid || 'unknown',
                uid: _userUid || 'unknown',
                variation_key: String(result.key),
                in_experiment: result.inExperiment ? 1 : 0,
              },
            });
          }
        } catch (e) {}
      },
    });

    _gbInstance = gb;

    gb.init().then(function() {
      var cfg = gb.getFeatureValue('perf_monitor_config', null);
      if (_rumEnv === 'test') console.log('[aippy-perf] GrowthBook config:', cfg);
      if (cfg && typeof cfg === 'object') {
        updateConfig(cfg);
      }
    }).catch(function(e) {
      if (_rumEnv === 'test') console.warn('[aippy-perf] GrowthBook init failed:', e);
    });
  }

  // ‚îÄ‚îÄ‚îÄ Public API ‚îÄ‚îÄ‚îÄ

  window.__aippyPerfMonitor = {
    getReport: function() { return computeWindowReport(); },
    stop: stop,
    updateConfig: updateConfig,
  };

  window.updatePerfConfig = function(cfg) {
    if (window.__aippyPerfMonitor) {
      window.__aippyPerfMonitor.updateConfig(cfg);
      return { success: true };
    }
    return { success: false, error: 'PerfMonitor not initialized' };
  };

  // ‚îÄ‚îÄ‚îÄ Bootstrap ‚îÄ‚îÄ‚îÄ

  if (window.__aippyPerfConfig && typeof window.__aippyPerfConfig === 'object') {
    updateConfig(window.__aippyPerfConfig);
  }
  loadGrowthBook();
  waitForRemoteConfig();
  setTimeout(start, 1200);
})();
