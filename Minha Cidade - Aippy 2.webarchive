ildren:[(0,Q.jsx)(`rect`,{x:`2`,y:`2`,width:`12`,height:`12`,fill:`#2f5f8f`}),(0,Q.jsx)(`rect`,{x:`4`,y:`4`,width:`8`,height:`8`,fill:`#3f8fd0`}),(0,Q.jsx)(`rect`,{x:`7`,y:`5`,width:`2`,height:`6`,fill:e}),(0,Q.jsx)(`rect`,{x:`5`,y:`7`,width:`6`,height:`2`,fill:e})]}),td=({tool:e,actionLabel:t,actionHint:n,theme:r,onSelectTool:i,onAction:a})=>(0,Q.jsxs)(`div`,{className:`absolute bottom-0 left-0 right-0 z-20 px-2.5 pb-3 pixel flex items-end justify-between gap-2 pointer-events-none`,children:[(0,Q.jsx)(`div`,{className:`flex flex-col gap-1.5 pointer-events-auto`,children:[`broom`,`blueprint`].map(t=>{let n=e===t;return(0,Q.jsxs)(`button`,{onPointerDown:()=>i(t),className:`btn-wood flex items-center gap-1.5 rounded-md border-2 px-2 py-1.5 text-[10px] font-bold`,style:{background:n?r.accent:r.woodDark,borderColor:n?`#fff6d5`:`#1c1008`,color:n?`#2e1a0c`:`#f3e3c4`},children:[t===`broom`?(0,Q.jsx)($u,{color:n?`#3a2414`:`#e8c26a`}):(0,Q.jsx)(ed,{color:n?`#3a2414`:`#e8c26a`}),t===`broom`?`VASSOURA`:`PROJETOS`]},t)})}),(0,Q.jsxs)(`div`,{className:`flex flex-col items-end gap-1 pointer-events-auto max-w-[62%]`,children:[n&&(0,Q.jsx)(`div`,{className:`rounded border-2 border-black/60 bg-black/70 px-2 py-1 text-[9px] text-amber-100/90 text-right`,children:n}),(0,Q.jsx)(`button`,{onPointerDown:a,disabled:!t,className:`btn-wood rounded-md border-2 px-4 py-2.5 text-[11px] font-bold shadow-lg disabled:opacity-35`,style:{background:t?r.accent:r.woodDark,borderColor:t?`#fff6d5`:`#1c1008`,color:t?`#2e1a0c`:`#f3e3c4`},children:t??`CAMINHE ATE UM PONTO`})]})]}),nd={antonio:{pending:`Vinte minutos pra subir tres degraus do posto, minha filha. A rampa ta la, mas e so um monte de cimento quebrado. Ja desisti de ir na consulta.`,pendingOthers:{elder:`Eu mesmo tentei subir esses degraus semana passada. Quase ca√≠. A gente envelhece, mas a calcada nao percebe.`,wheelchair:`A rampa do posto nao existe de verdade. Eu paro embaixo e volto pra casa. Vergonha e o que eu sinto, nao dor.`},choices:[{label:`A rampa entra na lista de obras prioritarias.`,reply:`Deus te ou√ßa. So de saber que alguem esta olhando pra gente, meu dia ja melhora.`,effects:{idosos:3}},{label:`O orcamento esta curto, Seu Antonio.`,reply:`Eu sei como e. Mas o povo envelhece todo dia, viu? A fila so aumenta.`,effects:{}},{label:`Vou pedir carona solidaria enquanto isso.`,reply:`Isso ajuda hoje. Mas amanha eu preciso de novo. Obra e o que fica.`,effects:{idosos:1,pcd:1}}],done:`Passei hoje pela rampa nova. Subi sozinho, sem ninguem me segurar. Fazia anos que eu nao ia ao posto sem pedir ajuda pro vizinho.`},marlene:{pending:`A praca e bonita, mas nao tem onde sentar. Banco de pedra, sem encosto, no sol. Meu joelho nao aguenta mais a volta inteira.`,pendingOthers:{elder:`A gente vem pra praca pra conversar, mas quem tem joelho ruim fica em pe. Banco com encosto muda o dia.`,wheelchair:`Banco sem espaco do lado nao serve pra mim. Preciso de um vao livre pra encostar a cadeira.`},choices:[{label:`Bancos com encosto e apoio de braco na praca.`,reply:`Com apoio de braco eu levanto sozinha! Isso e dignidade, nao e luxo.`,effects:{idosos:3,pcd:1}},{label:`Primeiro precisamos resolver o lixo.`,reply:`Justo. Mas sentar tambem e saude, minha filha. Nao deixe a gente pra depois.`,effects:{ambiente:1}},{label:`Vou conversar com o grupo da terceira idade.`,reply:`Converse mesmo. Ninguem sabe o que a praca precisa melhor do que quem fica aqui todo dia.`,effects:{idosos:2}}],done:`Sento no banco novo todos os dias as cinco da tarde. O apoio de braco ajuda a levantar. A praca virou sala de estar da cidade.`},bia:{pending:`Tem lixo de um monte de gente no meio da praca e a bola cai la dentro! A tia da escola disse que tem bicho, eca!`,pendingOthers:{elder:`A rampa la de casa e muito alta pra mim. Minha mae tem que me carregar, e ela ja tem dor nas costas.`,wheelchair:`A bola cai no lixo e eu nao consigo pegar. Fico so olhando as outras criancas brincarem.`},choices:[{label:`Vamos fazer um mutirao de limpeza no sabado.`,reply:`Uhuu! Eu levo a luva da minha mae e chamo o Teo! Depois a gente joga bola sem medo!`,effects:{ambiente:3,criancas:2}},{label:`Lugar de lixo e na lixeira, combinado?`,reply:`Combinado! Mas precisa ter lixeira baixinha, porque a alta eu nao alcanso.`,effects:{criancas:2,pcd:1}},{label:`Vou pedir pra escola falar sobre isso.`,reply:`A tia da escola explica tudo! Se ela falar, todo mundo para de jogar lixo.`,effects:{educacao:2}}],done:`A praca ta limpa! Hoje eu joguei bola ate escurecer e ninguem brigou. Voce vai fazer o parquinho tambem, ne?`},teo:{pending:`Eu queria brincar na praca, mas o chao tem um monte de latinha e sacola. Minha mae nao deixa. E tamb√©m nao tem parquinho.`,pendingOthers:{elder:`O parque novo tem chao fofinho! Se tivesse, minha avo podia ficar sentada olhando eu brincar.`,wheelchair:`Eu queria um brinquedo que roda. Cadeira de rodas tambem sabe girar.`},choices:[{label:`Mutirao de limpeza + lixeiras novas.`,reply:`Entao eu ajudo! Eu consigo pegar latinha pequena com a mao.`,effects:{ambiente:2,criancas:2}},{label:`Vou priorizar um parquinho seguro.`,reply:`Parquinho! Com chao fofinho pra nao ralar o joelho? Ai sim!`,effects:{criancas:3}},{label:`Precisamos economizar essa semana.`,reply:`Aaah... ta bom. Mas eu fico esperando, ta? So nao demora muito.`,effects:{}}],done:`Agora a praca ta cheia de crianca depois da aula. O parquinho ficou do lado da sombra, entao a gente brinca sem passar calor.`},carla:{pending:`Da esquina da escola ate a padaria tem rachadura, buraco e um degrau de dez centimetros. Eu desvio pela rua, no meio dos carros. Isso nao e escolha.`,pendingOthers:{elder:`Eu ja ca√≠ nessa calcada quebrada. Agora prefiro nao sair. A rua virou muro pra mim tambem.`,wheelchair:`Essa calcada quebrada e o motivo de eu ter desistido da fisioterapia. Cada ida e uma aventura.`},choices:[{label:`Nivelar a calcada e instalar piso tatil.`,reply:`Se for nivelado, eu atravesso sozinha. Nao preciso de favor, preciso de chao reto.`,effects:{pcd:3,idosos:1}},{label:`Vamos conversar com os moradores da rua.`,reply:`Boa. Mas conversa nao tira degrau. Precisa de obra e de projeto.`,effects:{pcd:1}},{label:`Nao ha verba para isso agora.`,reply:`Eu entendo. So lembra que eu pago imposto igual, e a rua nao me aceita.`,effects:{}}],done:`Atravessei hoje pela calcada nova, sem desviar pra rua. Cheguei na fisioterapia quinze minutos antes. Parece pouco, mas mudou minha semana.`}};function rd(e,t,n){let r=nd[e]??nd.antonio;return t?{text:r.done,choices:[{label:`Fico feliz que melhorou pra voce.`,reply:`Melhorou pra muita gente. Isso que importa.`,effects:{idosos:1,criancas:1,pcd:1}},{label:`Ainda falta muito, eu sei.`,reply:`Falta. Mas hoje ja da pra viver melhor. Uma obra por vez.`,effects:{}}]}:{text:(n===`child`?void 0:r.pendingOthers[n])??r.pending,choices:r.choices}}var id=({art:e,size:t=64,className:n})=>{let r=(0,l.useRef)(null);return(0,l.useEffect)(()=>{let n=r.current;if(!n)return;let i=n.getContext(`2d`);i&&(i.clearRect(0,0,n.width,n.height),Vu(i,n.width/2,n.height-6,e,Math.max(2,Math.floor(t/16))))},[e,t]),(0,Q.jsx)(`canvas`,{ref:r,width:t,height:t,className:`px-img ${n??``}`,style:{imageRendering:`pixelated`}})},ad=({npc:e,solved:t,avatar:n,theme:r,onEffects:i,onClose:a})=>{let o=rd(e.id,t,n),[s,c]=(0,l.useState)(null),u=e=>{let t=o.choices[e];t.effects&&i(t.effects),c(e)};return(0,Q.jsx)(`div`,{className:`absolute inset-x-0 bottom-0 z-40 p-2 pixel fade-in`,children:(0,Q.jsxs)(`div`,{className:`rounded-lg border-2 p-2.5 max-h-[52vh] overflow-y-auto no-scrollbar`,style:{background:`linear-gradient(180deg, ${r.wood} 0%, ${r.woodDark} 100%)`,borderColor:`#1c1008`,boxShadow:`inset 0 0 0 2px rgba(255,220,160,0.25), 0 -4px 0 rgba(0,0,0,0.4)`},children:[(0,Q.jsxs)(`div`,{className:`flex gap-2.5`,children:[(0,Q.jsx)(`div`,{className:`shrink-0 rounded border-2 border-black/60 flex items-center justify-center`,style:{width:62,height:62,background:`rgba(0,0,0,0.28)`},children:(0,Q.jsx)(id,{art:e.art,