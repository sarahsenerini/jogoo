_$W/"FF06C137826A97DAAEF66AFF9AA7EBB3"_Accept-Encoding, Origin_Tue, 07 Jul 2026 09:24:29 GMT“/0rs_NSMutableDictionary£tu3_NSMutableDictionary\NSDictionary_application/javascript“/0xy_NSHTTPURLResponse£z{3_NSHTTPURLResponse]NSURLResponse␀␀␀␀$␀)␀2␀7␀I␀L␀b␀d␀ç␀ì␀Æ␀–␀Ú␀ı<CehkçØ≤¥∂∏∫ºæ¿¬√≈«…À“⁄ÊËÍÏ).9BHKT]_ahp{âãçèëìïóôõùü°£±≥µ∑πªΩø¡√≈«…ÀÕÎ¯¸.6O]bkpuÉÖû¢ß∆ÊÎ!=d~û£πΩ”‡˘˛*␀␀␀␀␀␀␀␀␀␀␀␀␀|␀␀␀␀␀␀␀␀␀␀␀␀␀␀8OÖ›(function() {
  'use strict';

  if (window.__aippyPerfMonitor) return;

  // ‚îÄ‚îÄ‚îÄ Preserve native canvas getContext (for ARMS SDK hybrid only) ‚îÄ‚îÄ‚îÄ
  // Saved at load time to build a hybrid getContext after ARMS browser-sdk.js
  // patches the prototype: WebGL/WebGPU calls route through the native impl,
  // while 2D calls go through the SDK's patched version for instrumentation.
  // Black-screen detection uses HTMLCanvasElement.prototype.getContext directly
  // at call time (see probeWebGLContext) to avoid stale-reference issues in
  // Electron webviews where preload scripts can invalidate early-saved refs.
  var _nativeGetContext = HTMLCanvasElement.prototype.getContext;

  // ‚îÄ‚îÄ‚îÄ Parse project info from hostname ‚îÄ‚îÄ‚îÄ
  // Formats: [prefix--]<uuid>.aippynow.com / [prefix--]<uuid>.aippy.live
  var _projectUuid = '';
  var _projectVersion = 'release';
  var _rumEnv = 'prod';

  (function parseProjectInfo() {
    var host = '';
    try { host = window.location.hostname; } catch (e) {}
    var parts = host.split('.');
    if (parts.length < 2) return;
    var subdomain = parts[0];
    var sepIdx = subdomain.indexOf('--');
    if (sepIdx > 0) {
      _projectVersion = subdomain.substring(0, sepIdx);
      _projectUuid = subdomain.substring(sepIdx + 2);
    } else {
      _projectUuid = subdomain;
    }
  })();

  // ‚îÄ‚îÄ‚îÄ ARMS RUM SDK initialization ‚îÄ‚îÄ‚îÄ
  (function initArmsRum() {
    var host = '';
    try { host = window.location.hostname; } catch (e) {}
    var isDev = host.endsWith('.aippynow.com') || host === 'localhost' || host === '127.0.0.1';
    _rumEnv = isDev ? 'test' : 'prod';

    if (window.__rum) {
      window.__rum.env = _rumEnv;
      if (_projectVersion) window.__rum.version = _projectVersion;
      if (_projectUuid) {
        if (!window.__rum.app) window.__rum.app = {};
        window.__rum.app.package = _projectUuid;
      }
      return;
    }
    window.__rum = {
